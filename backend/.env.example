# Copy to backend/.env. Must match the values in the root .env / docker-compose.yml.
DATABASE_URL=postgresql+psycopg://laundry:laundry_dev_password@localhost:5432/laundryconnect
CORS_ORIGINS=http://localhost:5173

# Signs login tokens. Generate your own (each developer / server needs a different one):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Payments: "sandbox" simulates a gateway (no account needed); "payfast" uses
# PayFast – see docs/PAYMENTS.md, then check with python -m app.scripts.payfast_check
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Where PayFast returns customers and sends notifications (must be public https for ITN)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Address search (OpenStreetMap Nominatim). Put a contact e-mail or website in
# the User-Agent before going live – it's required by Nominatim's usage policy.
GEOCODER_ENABLED=true

# Per-IP rate limits (requests per IP address)
RATELIMIT_ENABLED=true
RATELIMIT_LOGIN_PER_MINUTE=20
RATELIMIT_LOGIN_PER_HOUR=100
RATELIMIT_REGISTER_PER_HOUR=10

# Backups (see docs/BACKUPS.md). Create the key with:
#   python -m app.scripts.backup --generate-key
# and also keep it in a password manager – without it backups can't be restored.
BACKUP_ENCRYPTION_KEY=
GEOCODER_USER_AGENT=LaundryConnect/0.1 (development build)
